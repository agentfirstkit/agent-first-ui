{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-first-ui:0.2:schema",
  "title": "Agent-First User Interface 0.2 wire schema",
  "description": "Validates the protocol envelope and the load-bearing layer only. AFUI space data is inert: a space carries typed facts, declared capabilities, and advisory hints; viewers decide how to render values and must not execute observed data. One shared space tree is split into sections keyed by owner. There are three messages: a snapshot of the receiving participant's projected space, an emit (an owner's JSON Patch change to its own section as delivered to one audience), and a request (a participant asking another owner to invoke a capability). One scoped binding marker carries `<scope>:<path>`, with scope in space/record/input/actor. It is strict where deviation breaks or breaches and permissive where viewer presentation is in charge: `kind` is an open string, unit fields are open, and domain fact names are unconstrained.",
  "$ref": "#/$defs/Message",
  "$defs": {
    "Message": {
      "type": "object",
      "required": [
        "agent_first_ui",
        "type"
      ],
      "properties": {
        "agent_first_ui": {
          "const": "0.2"
        },
        "type": {
          "enum": [
            "snapshot",
            "emit",
            "request"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "room"
            ]
          },
          {
            "required": [
              "proof"
            ]
          },
          {
            "required": [
              "signature"
            ]
          },
          {
            "required": [
              "public_key"
            ]
          },
          {
            "required": [
              "owner_key"
            ]
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "snapshot"
              }
            }
          },
          "then": {
            "required": [
              "space",
              "sequence"
            ],
            "properties": {
              "space": {
                "$ref": "#/$defs/Space"
              },
              "sequence": {
                "$ref": "#/$defs/Sequence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "emit"
              }
            }
          },
          "then": {
            "required": [
              "author",
              "sequence",
              "operations"
            ],
            "properties": {
              "author": {
                "$ref": "#/$defs/OwnerKey"
              },
              "sequence": {
                "$ref": "#/$defs/Sequence"
              },
              "operations": {
                "$ref": "#/$defs/Operations"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "request"
              }
            }
          },
          "then": {
            "required": [
              "author",
              "owner",
              "capability"
            ],
            "properties": {
              "author": {
                "$ref": "#/$defs/OwnerKey"
              },
              "capability": {
                "$ref": "#/$defs/Id"
              },
              "input": true,
              "owner": {
                "$ref": "#/$defs/OwnerKey"
              }
            }
          }
        }
      ],
      "description": "AFUI wire message. A request carries both author and target owner; AFUI does not carry authentication keys, signatures, or proof fields."
    },
    "Sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Position in the space's emit log. The snapshot carries the current position; each emit carries its own."
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "const": "-"
      },
      "description": "Stable, case-sensitive separator-safe id (`[A-Za-z0-9_-]`) unique within the owner section that declares it. Not a secret, not `-`, stable across emits when it refers to the same thing."
    },
    "OwnerKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "A separator-safe owner id generated by its participant. It is the top-level section key and intentionally avoids `.`, `:`, and `/` so bindings and JSON Pointers stay unambiguous."
    },
    "ScopedBinding": {
      "type": "string",
      "pattern": "^(space:|record:|input:|actor:)?[^:]+$",
      "description": "Binding value `<scope>:<path>`; scope in {space, record, input, actor}; omitted scope means space; path contains no ':'."
    },
    "Risk": {
      "enum": [
        "read_only",
        "local_mutation",
        "external_effect",
        "destructive"
      ],
      "description": "Load-bearing safety fact. Required on every capability; the viewer's gate is derived from it. Absent or unrecognized is treated as `destructive`."
    },
    "Space": {
      "type": "object",
      "description": "The shared tree, split into sections keyed by separator-safe owner ids. Each value is one owner section.",
      "additionalProperties": {
        "$ref": "#/$defs/Section"
      },
      "propertyNames": {
        "$ref": "#/$defs/OwnerKey"
      }
    },
    "Section": {
      "type": "object",
      "description": "One owner's facts. May carry declared capabilities and advisory hints (units, layouts, root_layout); all other members are the owner's domain facts.",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unit"
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Layout"
          }
        },
        "root_layout": {
          "$ref": "#/$defs/Id"
        }
      },
      "patternProperties": {
        "_uri$": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Capability": {
      "type": "object",
      "description": "An owner-declared affordance: what a participant may request from this owner.",
      "required": [
        "id",
        "label",
        "risk"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "applicable_binding": {
          "$ref": "#/$defs/ScopedBinding"
        },
        "input_schema": {
          "type": "object",
          "description": "JSON-Schema-compatible shape for the request input; only type:object is asserted here."
        }
      },
      "additionalProperties": true
    },
    "Unit": {
      "type": "object",
      "description": "An advisory recommendation: a coherent slice of facts to present, with an open semantic `kind`. Render guidance -- a viewer may use, adapt, or ignore it.",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic word, NOT an enum. Open by principle; the envelope schema intentionally does not constrain it."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "activate_capability": {
          "$ref": "#/$defs/Id"
        },
        "primary_capability": {
          "$ref": "#/$defs/Id"
        },
        "salience": {
          "$ref": "#/$defs/Salience"
        },
        "fallback": {
          "$ref": "#/$defs/Id"
        },
        "input_bindings": {
          "type": "object",
          "description": "Request input wiring. Keys are capability input field names; values are scoped bindings resolved when preparing a request from this unit.",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/ScopedBinding"
          }
        },
        "default": {
          "$ref": "#/$defs/Id"
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Id"
          }
        },
        "interactions": {
          "$ref": "#/$defs/Interactions"
        }
      },
      "patternProperties": {
        "_binding$": {
          "$ref": "#/$defs/ScopedBinding"
        },
        "_uri$": {
          "type": "string"
        },
        "(^capability$|_capability$)": {
          "$ref": "#/$defs/Id"
        },
        "(^capabilities$|_capabilities$)": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      },
      "additionalProperties": true
    },
    "Interactions": {
      "type": "object",
      "description": "Viewer interaction intents. A viewer may translate these into an emit to its own actor section or a risk-gated request to this unit's owner.",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/InteractionEffect"
        }
      }
    },
    "InteractionEffect": {
      "oneOf": [
        {
          "$ref": "#/$defs/SetActorStateEffect"
        },
        {
          "$ref": "#/$defs/RequestEffect"
        }
      ]
    },
    "ActorStatePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "description": "Dot path relative to the current actor's own section. It is never a space path and never names another owner."
    },
    "SetActorStateEffect": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "set_actor_state"
        },
        "path": {
          "$ref": "#/$defs/ActorStatePath"
        },
        "value_binding": {
          "$ref": "#/$defs/ScopedBinding"
        },
        "value": true
      },
      "oneOf": [
        {
          "required": [
            "value_binding"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "value_binding"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "RequestEffect": {
      "type": "object",
      "required": [
        "type",
        "capability"
      ],
      "properties": {
        "type": {
          "const": "request"
        },
        "capability": {
          "$ref": "#/$defs/Id"
        },
        "input_bindings": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/ScopedBinding"
          }
        }
      },
      "additionalProperties": true
    },
    "Layout": {
      "$comment": "An owner's recommended composition pool. Advisory render guidance; its only load-bearing content is the id graph. It never carries pixels, coordinates, or implementation vocabulary.",
      "type": "object",
      "required": [
        "id",
        "members"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "description": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "description": "Ordered ids of units or other layouts. Every id must resolve and the graph must be acyclic."
        },
        "overlay": {
          "type": "boolean"
        },
        "salience": {
          "$ref": "#/$defs/Salience"
        },
        "relation": {
          "type": "string",
          "description": "Optional View Hint Profile composition relation. The envelope schema keeps this open; the optional view-hint schema constrains canonical values."
        },
        "role": {
          "type": "string",
          "description": "Optional View Hint Profile semantic region role. The envelope schema keeps this open; the optional view-hint schema constrains canonical values."
        }
      },
      "additionalProperties": true
    },
    "Salience": {
      "type": "object",
      "properties": {
        "prominence": {
          "enum": [
            "primary",
            "normal",
            "subtle"
          ]
        },
        "state": {
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ]
        }
      },
      "additionalProperties": false
    },
    "Operations": {
      "type": "array",
      "description": "The operations of an emit: JSON Patch (RFC 6902) over the space. The protocol does not redefine it.",
      "items": {
        "$ref": "#/$defs/Operation"
      }
    },
    "Operation": {
      "type": "object",
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "move",
            "copy",
            "test"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(/[^/]*)*$"
        },
        "from": {
          "type": "string",
          "pattern": "^(/[^/]*)*$"
        },
        "value": true
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "replace",
                  "test"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "move",
                  "copy"
                ]
              }
            }
          },
          "then": {
            "required": [
              "from"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
